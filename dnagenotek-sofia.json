    "components": {
      "schemas": {
        "status": {
          "required": [
            "status"
          ],
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "example": "success"
            }
          },
          "description": "Affirmative response to healthcheck"
        },
        "order": {
          "required": [
            "destination",
            "id",
            "items"
          ],
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "An automatically assigned, unique identifier for a given order. This identifier can be used to retrieve an individual order.",
              "format": "uuid"
            },
            "destination": {
              "$ref": "#/components/schemas/destination"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/item"
              }
            },
            "kits": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/kits"
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/label"
              }
            },
            "customer_id": {
              "type": "string",
              "description": "Use this field to assign an ID that traces back to your records.",
              "example": "AFW-123-340#87"
            },
            "outbound_tracking": {
              "type": "string",
              "description": "When a package moves from “fulfillment” to “shipped”, this will be populated with the tracking number for the shipment to the destination.",
              "example": "PX01010101010101"
            },
            "fulfillment_id": {
              "type": "string",
              "description": "The fulfillment order number for the Order.",
              "example": "B1001010"
            },
            "service_level": {
              "type": "string",
              "example": "USPS First-Class Mail (Endicia)"
            },
            "error_detail": {
              "type": "string",
              "description": "If an error is encountered during processing, this field will contain a descriptive error message."
            },
            "status": {
              "type": "string",
              "description": "The current status of the order. This can be either `pending`, `fulfillment`, `shipped`, or `error`.",
              "example": "shipped"
            },
            "created_on": {
              "type": "string",
              "example": "YYYY-MM-DDThh:mm:ss.sss+hh:mm"
            },
            "expected_shipped_on": {
              "type": "string",
              "example": "YYYY-MM-DDThh:mm:ss.sss+hh:mm"
            },
            "shipped_on": {
              "type": "string",
              "example": "YYYY-MM-DDThh:mm:ss.sss+hh:mm"
            },
            "updated_on": {
              "type": "string",
              "example": "YYYY-MM-DDThh:mm:ss.sss+hh:mm"
            }
          },
          "description": " The Orders endpoint lets you submit new outbound orders, and keep track of shipment tracking and status information for submitted orders. The API allows you to create a new order, update an existing order, retrieve information on an individual order, or list all of the orders associated with your account.\n\nThis description reflects the current state of the API. If your configuration requires additional fields or customizations, we can add these as necessary, maintaining backwards compatibility wherever possible.\n\nSome attributes of the Order object are generic across all accounts and orders, while others, such as labels, are dependent upon the configuration in your agreement with DNA Genotek. "
        },
        "order_patch": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "An automatically assigned, unique identifier for a given order. This identifier can be used to retrieve an individual order.",
              "format": "uuid"
            },
            "fulfillment_id": {
              "type": "string",
              "description": "The fulfillment order number for the Order.",
              "example": "B1001010"
            },
            "status": {
              "type": "string",
              "description": "The current status of the order. This can be either `pending`, `fulfillment`, `shipped`, or `error`.",
              "example": "shipped"
            },
            "outbound_tracking": {
              "type": "string",
              "description": "When a package moves from “fulfillment” to “shipped”, this will be populated with the tracking number for the shipment to the destination.",
              "example": "PX01010101010101"
            },
            "shipped_on": {
              "type": "string",
              "example": "YYYY-MM-DDThh:mm:ss.sss+hh:mm"
            },
            "kits": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/kits"
              }
            },
            "error_detail": {
              "type": "string",
              "description": "If an error is encountered during processing, this field will contain a descriptive error message."
            }
          },
          "description": " The Orders endpoint lets you submit new outbound orders, and keep track of shipment tracking and status information for submitted orders. The API allows you to create a new order, update an existing order, retrieve information on an individual order, or list all of the orders associated with your account.\n\nThis description reflects the current state of the API. If your configuration requires additional fields or customizations, we can add these as necessary, maintaining backwards compatibility wherever possible.\n\nSome attributes of the Order object are generic across all accounts and orders, while others, such as labels, are dependent upon the configuration in your agreement with DNA Genotek. "
        },
        "destination": {
          "required": [
            "address_1",
            "city",
            "co_first_name",
            "co_last_name",
            "co_phone_number",
            "country",
            "postal_code",
            "region"
          ],
          "type": "object",
          "properties": {
            "co_first_name": {
              "type": "string",
              "example": "John"
            },
            "co_last_name": {
              "type": "string",
              "example": "Appleseed"
            },
            "co_phone_number": {
              "type": "string",
              "example": "408-867-5309"
            },
            "company": {
              "type": "string",
              "example": "ACME Corp"
            },
            "address_1": {
              "type": "string",
              "example": "3000-5 Palladium Drive"
            },
            "address_2": {
              "type": "string",
              "description": "Must be blank for country: CA",
              "example": ""
            },
            "city": {
              "type": "string",
              "example": "Ottawa"
            },
            "region": {
              "type": "string",
              "example": "true"
            },
            "country": {
              "type": "string",
              "example": "CA"
            },
            "postal_code": {
              "type": "string",
              "description": "Canada: C#C#C#, US: #####/#####-####",
              "example": "K2V1C2"
            }
          }
        },
        "item": {
          "required": [
            "quantity",
            "sku"
          ],
          "type": "object",
          "properties": {
            "sku": {
              "type": "string",
              "description": "The SKU is defined in the SOW and identify the custom box and contents that will be shipped for the order.",
              "example": "1000"
            },
            "quantity": {
              "type": "integer",
              "description": "The quantity of the corresponding SKU to be included in the order.",
              "example": 1
            }
          },
          "description": "An object containing a SKU and a corresponding quantity."
        },
        "kits": {
          "type": "object",
          "properties": {
            "barcode": {
              "type": "string",
              "example": "AAAA20160121ZZZZ"
            },
            "return_tracking": {
              "type": "string",
              "example": "10101010101010"
            },
            "pmi": {
              "type": "string",
              "description": "Assigned by fulfillment team. First 4 numbers (usually) match SKU of item ordered.",
              "example": "201602080001"
            }
          }
        },
        "label": {
          "required": [
            "label_line_1",
            "label_line_2",
            "sample_id"
          ],
          "type": "object",
          "properties": {
            "sample_id": {
              "type": "string",
              "example": "AAAA20160121ZZZZ"
            },
            "label_line_1": {
              "type": "string",
              "example": "1951-02-54"
            },
            "label_line_2": {
              "type": "string",
              "example": "Special instructions to be added and scanned"
            }
          },
          "description": "Object representing secondary labels to be included in the order. This object can be customized to hold additional data to an order or for customizations in fulfillment."
        },
        "new_order": {
          "required": [
            "destination",
            "items"
          ],
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/components/schemas/destination"
            },
            "items": {
              "type": "array",
              "description": "A list of line items containing a SKU and a corresponding quantity.",
              "items": {
                "$ref": "#/components/schemas/item"
              }
            },
            "labels": {
              "type": "array",
              "description": "Optional list of labels.",
              "items": {
                "$ref": "#/components/schemas/label"
              }
            },
            "customer_id": {
              "type": "string",
              "description": "Assign an ID that traces back to your records.",
              "example": "AFW-123-340#87"
            },
            "service_level": {
              "type": "string",
              "description": "Determines the expected shipped date and method for shipping.",
              "example": "USPS First-Class Mail (Endicia)"
            }
          },
          "description": " A new order requires a small subset of the parameters of the full order object to request a new order to be fulfilled. "
        },
