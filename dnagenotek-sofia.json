{
    "openapi": "3.0.0",
    "info": {
      "title": "SOFIA Docs",
      "description": "# Introduction \nWelcome to **SOFIA**, the **S**ingle **O**rder **F**ulfillment **I**ntegration **A**PI.\n\nFor the latest version of SOFIA Docs please use <a href=\"https://app.swaggerhub.com/apis-docs/dnagenotek/sofia/2\">SwaggerHub</a>.\n\nYou can use the API to access SOFIA endpoints, which let you submit and retrieve new orders, and look up status information for existing orders.\n<aside class=\"warning\"> All requests must be made over HTTPS. Any HTTP requests will not be accepted by the server. </aside>\n\n# Authentication\n## Basic Auth\nSOFIA uses API keys and HTTP Basic Authentication to authenticate access to the API.\nUsing HTTP Basic Auth, SOFIA expects the API key as the username, with a blank password. For example, to authenticate using curl:\n<code>curl \"https://sofia.dnagenotek.com/v2/orders\" -u \"api_secret_key:\"</code>\n<aside class=\"notice\"> You must replace <code>api_secret_key</code> with your personal API key. The colon after the API key is required when specifying the authentication header directly. You can request your API key from <a href=\"mailto:sofia@dnagenotek.com\">sofia@dnagenotek.com</a></aside>\n\n## OAuth\nFor OAuth Credentials and details on client Credential token flow contact SOF Support.\n# Versioning\nWhen we make backwards-incompatible changes to the API, we release new, versioned endpoints. The current version is `v2`, and can be accessed at `https://sofia.dnagenotek.com/api/v2`.\n# Errors\nSome common API errors and context is given below to help with most common scenarios and to help your validation efforts with the integration.\n## 500 Level Errors\nErrors in the 500 range are server errors. Our team will be notified and will take the nescessary steps to correct and prevent server errors. Some coordination may be nescessary to ensure orders are in the correct state and any data loss or duplication has been corrected. Please contact our team in this case.",
      "contact": {
        "email": "sofia@dnagenotek.com"
      },
      "version": "2"
    },
    "servers": [
      {
        "url": "https://sofia-stage.dnagenotek.com"
      },
      {
        "url": "https://sofia.dnagenotek.com"
      }
    ],
    "security": [
      {
        "BasicAuth": []
      },
      {
        "OAuth2": []
      },
      {
        "BearerAuth": []
      }
    ],
    "paths": {
      "/api/v1/status": {
        "get": {
          "tags": [
            "Public & HTTP"
          ],
          "responses": {
            "200": {
              "description": "Health check",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/inline_response_200"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v2/orders": {
        "get": {
          "tags": [
            "Customers V2",
            "Fulfillment"
          ],
          "summary": "List orders",
          "description": "By passing in the appropriate options, you can search for\norders in the system\n",
          "operationId": "list_orders_v2",
          "parameters": [
            {
              "name": "created_after",
              "in": "query",
              "description": "example: 2019-03-14 minimum created on date",
              "required": false,
              "style": "form",
              "explode": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "updated_after",
              "in": "query",
              "description": "example: 2019-03-14 minimum updated on date",
              "required": false,
              "style": "form",
              "explode": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "status",
              "in": "query",
              "description": "one of pending, fulfillment, shipped, error",
              "required": false,
              "style": "form",
              "explode": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "secondary_id",
              "in": "query",
              "description": "pass an optional customer_id to match",
              "required": false,
              "style": "form",
              "explode": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "per_page",
              "in": "query",
              "required": false,
              "style": "form",
              "explode": true,
              "schema": {
                "type": "number"
              }
            },
            {
              "name": "page",
              "in": "query",
              "required": false,
              "style": "form",
              "explode": true,
              "schema": {
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "search results matching criteria",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/inline_response_200_1"
                  }
                }
              }
            },
            "400": {
              "description": "bad input parameter"
            }
          }
        },
        "post": {
          "tags": [
            "Customers V2"
          ],
          "summary": "Create an order",
          "description": "Creates an order to be fulfilled",
          "operationId": "new_order_v2",
          "requestBody": {
            "description": "New order to fulfill",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/new_order"
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "item created",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/order"
                    }
                  }
                }
              }
            },
            "400": {
              "description": "invalid input, object invalid"
            },
            "403": {
              "description": "forbidden, usually due to authentication"
            }
          }
        }
      },
      "/api/v2/orders/{order_id}": {
        "get": {
          "tags": [
            "Customers V2",
            "Fulfillment"
          ],
          "summary": "Retrieve an order",
          "description": "By passing in the appropriate options, you can search for orders in the system\n",
          "operationId": "get_order_v2",
          "parameters": [
            {
              "name": "order_id",
              "in": "path",
              "description": "ID of order to return",
              "required": true,
              "style": "simple",
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "search results matching criteria",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/order"
                    }
                  }
                }
              }
            },
            "400": {
              "description": "bad input parameter"
            }
          }
        },
        "patch": {
          "tags": [
            "Fulfillment"
          ],
          "summary": "Update an order",
          "description": "Updates an order with shipped details and kits.",
          "operationId": "update_order",
          "parameters": [
            {
              "name": "order_id",
              "in": "path",
              "description": "ID of order to return",
              "required": true,
              "style": "simple",
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            }
          ],
          "requestBody": {
            "description": "order to update",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/order_patch"
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "item updated"
            },
            "400": {
              "description": "invalid input, object invalid"
            },
            "403": {
              "description": "forbidden, an order is already in shipped/error status and cannot be updated,"
            }
          }
        }
      },
      "/api/v2/orders/return": {
        "post": {
          "tags": [
            "Fulfillment"
          ],
          "summary": "Create a bulk return order",
          "description": "Creates a bulk return order to be fulfilled.\nThis actually uses the `/orders` path.",
          "operationId": "bulk_order",
          "requestBody": {
            "description": "Parameter subset of the full order object to request a new bulk return order to be fulfilled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/new_bulk_order"
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "item created",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/new_bulk_order"
                    }
                  }
                }
              }
            },
            "400": {
              "description": "invalid input, object invalid"
            },
            "403": {
              "description": "forbidden, usually due to authentication"
            }
          }
        }
      },
